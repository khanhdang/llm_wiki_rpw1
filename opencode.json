{
  "$schema": "https://opencode.ai/config.json",
  "model": "omlx/gemma-4-e4b-it-4bit",
  "permission": {
    "read": {
      "*": "allow",
      "raw/restricted/**": "deny",
      "sources/restricted/**": "deny",
      "extracted/restricted/**": "deny",
      "raw/internal/**": "ask",
      "sources/internal/**": "ask",
      "extracted/internal/**": "ask"
    },
    "edit": {
      "*": "allow",
      "raw/**": "deny",
      "sources/**": "ask",
      ".claude/**": "deny",
      "opencode.json": "deny",
      "AGENTS.md": "ask",
      "tools/**": "ask"
    },
    "list": {
      "*": "allow",
      "raw/**": "deny",
      "sources/restricted/**": "deny",
      "extracted/restricted/**": "deny"
    },
    "glob": {
      "*": "allow",
      "raw/**": "deny",
      "*restricted*": "deny"
    },
    "grep": {
      "*": "allow",
      "raw/**": "deny",
      "*restricted*": "deny"
    },
    "bash": {
      "*": "ask",
      "* raw/*": "ask",
      "python tools/lint.py*": "allow",
      "python3 tools/lint.py*": "allow",
      "python tools/validate_manifests.py*": "allow",
      "python3 tools/validate_manifests.py*": "allow",
      "bash tools/check_raw.sh": "allow",
      "./tools/check_raw.sh": "allow",
      "tools/check_raw.sh": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "*restricted*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
